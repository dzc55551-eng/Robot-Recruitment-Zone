{
  "repos": [
    {
      "owner": "dzc55551-eng",
      "repo": "Robot-Recruitment-Zone",
      "branch": "main",
      "local_path": ".",
      "generators": ["docs_index", "heartbeat"],
      "active_hours": [0, 24],
      "max_files": 3,
      "max_lines": 60,
      "commit_prefix": "chore(status)",
      "heartbeat": {
        "path": "positions/status.json",
        "collections": [
          {"key": "positions_open", "glob": "*.md", "exclude": ["README.md"]},
          {"key": "positions_archived", "glob": "archive/*.md"}
        ],
        "titles": {"key": "titles", "glob": "*.md", "exclude": ["README.md"]}
      },
      "index": {
        "section": "在招岗位列表",
        "glob": "*.md",
        "exclude": ["README.md"]
      }
    }
  ]
}
